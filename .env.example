# Pflicht
BASE_URL=https://planer.example.com
SESSION_SECRET=            # mind. 32 Zeichen, z. B.: openssl rand -hex 32
OIDC_ISSUER=https://idp.example.com/application/o/hv-planer/
OIDC_CLIENT_ID=hv-planer
OIDC_CLIENT_SECRET=

# Optional
# OIDC_AUTH_METHOD=basic        # basic | post | none (public client mit PKCE)
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_EMAILS=a@example.com,b@example.com
# OIDC_ALLOWED_GROUPS=hv-planer
# OIDC_GROUPS_CLAIM=groups      # Scope "groups" ggf. in OIDC_SCOPES ergänzen
# SHARE_PLANS=false             # true: alle angemeldeten Nutzer sehen/bearbeiten alle Pläne
# SESSION_TTL_HOURS=168
# HISTORY_KEEP=50
# HISTORY_MIN_INTERVAL_MINUTES=10
# DB_PATH=/data/hv-planer.sqlite
