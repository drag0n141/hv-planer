# Required
APP_URL=https://planer.example.com        # public URL of the app, no trailing slash
SESSION_SECRET=                           # at least 32 characters, e.g. openssl rand -hex 32
OIDC_ISSUER_URL=https://idp.example.com/application/o/hv-planer/
OIDC_CLIENT_ID=hv-planer

# Optional
# OIDC_CLIENT_SECRET=                     # empty = public client (PKCE only)
# OIDC_PROVIDER_NAME=OIDC Provider        # label of the login button
# OIDC_SCOPES=openid email profile
# SHARE_PLANS=false                       # true: all signed-in users see and edit all plans
# SESSION_TTL_HOURS=168
# HISTORY_KEEP=50
# HISTORY_MIN_INTERVAL_MINUTES=10
