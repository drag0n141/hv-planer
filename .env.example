# Pflicht
APP_URL=https://planer.example.com        # öffentliche URL der App (ohne Slash am Ende)
SESSION_SECRET=                          # mind. 32 Zeichen, z. B.: openssl rand -hex 32
OIDC_ISSUER_URL=https://idp.example.com/application/o/hv-planer/
OIDC_CLIENT_ID=hv-planer

# Optional
# OIDC_CLIENT_SECRET=                    # leer = öffentlicher Client (nur PKCE)
# OIDC_PROVIDER_NAME=OIDC Provider       # Beschriftung des Login-Buttons
# OIDC_SCOPES=openid email profile       # für Gruppen z. B. "openid email profile groups"
# OIDC_ALLOWED_EMAILS=a@example.com,b@example.com
# OIDC_ALLOWED_GROUPS=hv-planer
# OIDC_GROUPS_CLAIM=groups
# SHARE_PLANS=false                      # true: alle angemeldeten Nutzer sehen/bearbeiten alle Pläne
# SESSION_TTL_HOURS=168
# HISTORY_KEEP=50
# HISTORY_MIN_INTERVAL_MINUTES=10
# DB_PATH=/data/hv-planer.sqlite
